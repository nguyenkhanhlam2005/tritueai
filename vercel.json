{
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "([ -x node_modules/.bin/vite ] || npm install) && ./node_modules/.bin/vite build",
  "outputDirectory": "dist",
  "functions": {
    "api/*.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
